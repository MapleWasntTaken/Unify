# Copy this file to financialapp/.env for local development.
# Never commit the copied file or real values.
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/finappdb
JDBC_DATABASE_USERNAME=replace-me
JDBC_DATABASE_PASSWORD=replace-me

PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me
# Allowed values: sandbox or prod (case-insensitive binding)
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://example.com/api/plaid/webhook

# Generate with: openssl rand -hex 32
REMEMBER_ME_KEY=replace-with-at-least-32-characters
ENCRYPTION_KEY=replace-me
